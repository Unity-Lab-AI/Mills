# VibeRoller hub on the lab server, as a systemd USER service of the account that owns the hub's work area (no root
# needed; deploy/setup-server.sh installs it to ~/.config/systemd/user/ with the paths filled in). The account must have
# lingering on (root, once: loginctl enable-linger <user>) so it runs from boot, before anyone signs in.
#   systemctl --user status viberoller-hub       journalctl --user -u viberoller-hub -f
[Unit]
Description=VibeRoller hub (team hub + Work runs, behind nginx)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__BASE__/app/bridge
# Everything the hub writes lives under __BASE__ (the live checkout with its data, Claude Code's login + settings)
# and the shared projects area; the group owns the folders, so the whole team can read and repair them.
Environment=HOME=__BASE__/home
Environment=CLAUDE_CONFIG_DIR=__BASE__/home/.claude
Environment=PATH=__BASE__/node/current/bin:__BASE__/tools/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=__BASE__/node/current/bin/node run.js --no-tunnel
Restart=on-failure
RestartSec=5
# run.js exits 0 / 2 for a clean stop or "already running" (no restart); anything else is a crash and restarts.
# Graceful restarts (bridge/restart.js, the auto-deploy) happen inside run.js and never stop this service.
SuccessExitStatus=0 2
# group-writable, nothing for others: the team's accounts share the work area through its group
UMask=0007
NoNewPrivileges=yes

[Install]
WantedBy=default.target
