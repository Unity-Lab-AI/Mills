# Whitelist: only the Mills app is published. The UAL .claude/ template,
# its docs, install scripts and its Forgejo history stay local (IP boundary).
/*
!/.gitignore
!/.gitattributes
!/README.md
!/versions.json
!/CHANGELOG.md
!/LAWS.md
!/deploy/
!/.forgejo/
!/web/
!/bridge/
!/.github/
!/native/
# Rust build output (cargo) never ships
native/target/
native/dist/
native/crates/vr-desktop/gen/

# Runtime state written by the hub on the host PC
bridge/state.json
bridge/workspace/
node_modules/
bridge/auth.json
bridge/.mcp-runtime.json
bridge/tunnel.json
bridge/.restart
bridge/restart.log
bridge/hub-state.json
bridge/usage.json
bridge/profiles-deleted/
bridge/*.tmp

# Accounts are local to the host: every file under bridge/profiles/ stays off the remotes
# (display names, admin flags, password hashes, device locks, sessions).
bridge/profiles/

# Workflow state, caches and logs that must never ship
*.log
*.tmp
.restart
Chat/
Archive/

# Assistant: persona prompt (host-local) and per-account data
bridge/assistant-persona.txt
bridge/assistant.json
# AI providers people hooked up (API keys / login folders / endpoints) and the empty folder API calls run in
bridge/providers.json
Api/
# Forgejo issue mirroring: the host's token + repo (never committed); team notes live on the host only
bridge/forgejo.json
# this machine's own hub settings, laid over config.json (deploy/config.local.example.json)
bridge/config.local.json
bridge/ai-node.json
bridge/ai-node.lock
# Work uploads of the default account (everyone else's are under bridge/profiles/<user>/uploads, ignored with profiles)
bridge/uploads/
bridge/uploads-index.json
bridge/uploads-index.json.tmp
# an AI host's own state: its live status for the control app, requests from it, its updates in progress
bridge/ai-node.status.json
bridge/ai-node.status.json.tmp
bridge/ai-node.log
bridge/.stop-now
bridge/.restart-now
bridge/.update-now
bridge/.update-trial.json
bridge/.update-bad
bridge/.update-backup/
bridge/.update-staging/
# AI hosts (UUID + secret + nickname per host; Settings → My AI hosts) and a host's per-run MCP files
bridge/ai-hosts.json
# the release key that signs the native binaries (bridge/native-releases.js): its secret never leaves this machine
bridge/release-key.json
bridge/ai-host-sessions.json
bridge/.mcp-host-*.json
# the hand-off to the server (bridge/handoff.js): this machine runs the AI host instead of the hub; writes paused during the move
bridge/.handoff
bridge/.maintenance
# the host's AI on/off switch + the host tools built on that machine (bridge/host-tools/build.cmd)
bridge/ai-host.off
bridge/host-tools/*.exe
bridge/host-tools/*.ico
# server owners + co-owners set by the host (names stay off the remotes)
bridge/server-owners.json
# profile pictures (Settings → Profile), on the host only
Avatars/
# My Forgejo: everyone's own Forgejo token (Settings), kept on the host only
bridge/forgejo-users.json
Notes/
Images/
__pycache__/
*.pyc
