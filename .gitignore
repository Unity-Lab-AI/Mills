# Whitelist: only the Mills app is published. The UAL .claude/ template,
# its docs, install scripts and its Forgejo history stay local (IP boundary).
/*
!/.gitignore
!/.gitattributes
!/README.md
!/web/
!/bridge/
!/.github/

# Runtime state written by the bridge on Alfreddo's PC
bridge/state.json
bridge/workspace/
node_modules/
bridge/auth.json
bridge/.mcp-runtime.json
bridge/tunnel.json
bridge/.restart
bridge/restart.log
bridge/hub-state.json
bridge/profiles-deleted/
bridge/*.tmp

# Per-profile runtime state (one profile per extra person, e.g. bridge/profiles/sponge/).
# profiles/<name>/config.json (port + display name) stays tracked.
bridge/profiles/*/auth.json
bridge/profiles/*/state.json
bridge/profiles/*/.mcp-runtime.json
bridge/profiles/*/tunnel.json
bridge/profiles/*/.restart
bridge/profiles/*/*.tmp
