{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeRoller",
  "identifier": "com.unityailab.viberoller",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["tools"]
    }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"] }
}
